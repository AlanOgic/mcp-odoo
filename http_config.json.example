{
  "host": "0.0.0.0",
  "port": 8000,
  "path": "/mcp",
  "require_https": false,
  "allowed_origins": ["*"],
  "ssl_certfile": null,
  "ssl_keyfile": null,
  "ssl_ca_certs": null,
  "default_rate_limit": 1000,
  "session_timeout": 3600,
  "max_sessions": 100,
  "allow_credentials": true,
  "allow_methods": ["GET", "POST", "OPTIONS"],
  "allow_headers": [
    "Authorization",
    "Content-Type",
    "Mcp-Session-Id",
    "Accept"
  ],
  "expose_headers": [
    "Mcp-Session-Id",
    "Content-Type"
  ],
  "max_age": 600,
  "max_request_size": 10485760,
  "request_timeout": 300
}
